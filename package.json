{
  "name": "complaint-lifecycle-engine",
  "version": "1.0.0",
  "description": "Enterprise AI-Powered Complaint Management System (Associate AI Forward Deployed Engineer)",
  "scripts": {
    "build": "python -m pytest tests/ -v",
    "test": "python -m pytest tests/ -v",
    "generate": "python src/run.py --scale 1.0",
    "generate:starter": "python src/run.py --scale 0.1",
    "reproducibility": "python src/run.py --reproducibility-check",
    "start": "uvicorn src.api:app --host 0.0.0.0 --port 8000"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
